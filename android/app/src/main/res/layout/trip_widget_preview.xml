<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the Android widget picker (previewLayout). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2232323">

    <!-- Accent bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FFC8592A" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:gravity="center_vertical">

        <!-- Header: trip name + last update -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="París 2025"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFF5F3EF"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textSize="9sp"
                android:textColor="#AAF5F3EF"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Divider -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="#28FFFFFF" />

        <!-- Total -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EUR 847.50"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFC8592A"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Balance summary -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sophie -85  Lucas +141  Emma -56"
            android:textSize="10sp"
            android:textColor="#AAF5F3EF"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
